=end

require 'uri'
require 'set'
require 'optparse'
require 'json'

class URLExtractor
  # Regex pattern to match absolute URLs in any text format
  # Matches: scheme://host[:port]/path
  # Format-agnostic: works with HTML, JSON, Markdown, code, etc.
  URL_PATTERN = %r{
    (?:https?|ftp)://[^\s"'<>]+
  }x

  # Regex pattern to match relative URLs (paths starting with / or relative paths)
  # Matches: /path/to/resource, /path?query=param, ./relative, ../sibling
  RELATIVE_URL_PATTERN = %r{
    (?:^|[>\s"])(/[^\s"'<>]*|\.\.?/[^\s"'<>]*)
  }x

  # Track warnings and stats
  attr_reader :warnings, :stats

  def initialize(text, exclude_internal: false, base_url: nil)
    @text = text
    @urls = []
    @dedup_map = {} # maps dedup key (scheme-agnostic) to {canonical:, variations:, schemes:, count:}
    @warnings = []
    @exclude_internal = exclude_internal
    @base_url = base_url
    @stats = {
      urls_found: 0,
      urls_valid: 0,
      urls_invalid: 0,
      relative_urls: 0,
      internal_ips: 0,
      user_info_urls: 0,
      excluded_internal: 0
    }
  end

  def extract
    # Extract absolute URLs from text (format-agnostic)
    # Works with HTML, JSON, Markdown, code, YAML, etc.
    @text.scan(URL_PATTERN) do |url_string|
      process_url(url_string)
    end

    # Extract relative URLs if base_url is provided
    if @base_url
      @text.scan(RELATIVE_URL_PATTERN) do |match|
        relative_url = match.is_a?(Array) ? match.last : match
        next if relative_url.nil? || relative_url.empty?

        # Resolve relative URL against base
        absolute_url = resolve_relative_url(relative_url.strip)
        process_url(absolute_url) if absolute_url
        @stats[:relative_urls] += 1
      end
    end

    self
  end

  def resolve_relative_url(relative_path)
    return nil if relative_path.empty?

    begin
      base_uri = normalize_base_url(@base_url)
      return nil if base_uri.nil?

      # Remove query and fragment from relative path
      clean_path = relative_path.sub(/[?#].*/, '')

      # Resolve the relative path
      resolved = base_uri.merge(clean_path)
      resolved.to_s
    rescue StandardError => e
      @warnings << "Failed to resolve relative URL '#{relative_path}': #{e.message}"
      nil
    end
  end

  def normalize_base_url(url)
    return nil if url.nil? || url.empty?

    # If URL doesn't have a scheme, add https://
    url = "https://#{url}" unless url =~ /^[a-z]+:\/\//i

    URI.parse(url)
  rescue StandardError => e
    @warnings << "Invalid base URL '#{url}': #{e.message}"
    nil
  end

  def deduplicate
    # Deduplication already happens in process_url via @canonical_map
    self
  end

  def sorted_urls(filter: nil)
    # Return sorted canonical URLs, optionally filtered by domain
    urls = @dedup_map.values.map { |entry| entry[:canonical] }.sort
    return urls unless filter

    urls.select { |url| URI.parse(url).host&.include?(filter) }
  end

  def deduplicated_data(filter: nil)
    # Return deduplicated data organized by key, sorted by canonical URL, optionally filtered
    data = @dedup_map.sort_by { |_, entry| entry[:canonical] }.to_h
    return data unless filter

    data.select { |_, entry| URI.parse(entry[:canonical]).host&.include?(filter) }
  end

  def total_variations
    # Total count of URL variations across all deduplicated entries
    @dedup_map.values.sum { |entry| entry[:variations].length }
  end

  def dedup_key(uri, host, port, path)
    # Dedup key is scheme-agnostic: used to identify duplicate URLs with different schemes
    # format: host:port/path (no scheme)
    key = host&.downcase || ''
    key += ":#{port}" if port && !default_port?(uri.scheme, port)
    key += path
    key
  end

  def canonical_form(url_string)
    begin
      uri = URI.parse(url_string)

      # Validate scheme
      return nil unless %w[http https ftp].include?(uri.scheme)

      # Warn on internal IPs
      warn_on_internal_ip(uri.host) if uri.host

      # Warn on user info
      warn_on_user_info(uri) if uri.user

      # Build canonical form
      scheme = uri.scheme&.downcase
      host = uri.host&.downcase
      port = uri.port
      path = uri.path || ''

      # Normalize path: ensure leading / for non-empty paths, strip trailing /
      path = "/#{path}" unless path.empty? || path.start_with?('/')

      # Resolve . and .. in path (e.g., /path/to/file/.. becomes /path/to)
      path = normalize_path(path)

      # Strip trailing slash except for root
      path = path.sub(%r{/$}, '') if path != '/'

      # Create dedup key (scheme-agnostic)
      key = dedup_key(uri, host, port, path)

      # Build the canonical URL
      canonical_url = "#{scheme}://#{host}"
      canonical_url += ":#{port}" if port && !default_port?(scheme, port)
      canonical_url += path

      # Return both canonical URL and dedup key
      {
        scheme: scheme,
        host: host,
        port: port,
        path: path,
        key: key,
        url: canonical_url
      }
    rescue URI::InvalidURIError, StandardError => e
      msg = "Invalid URL '#{url_string}': #{e.message}"
      @warnings << msg
      nil
    end
  end

  private

  def process_url(url_string)
    @stats[:urls_found] += 1

    # Clean trailing punctuation from URL text
    # Only remove obvious markup/sentence punctuation: ) ] } , ; ! ?
    # Preserve: . (could be sentence-end or part of path/domain) and : (part of scheme)
    # Conservative approach: only remove what's clearly not part of a URL
    url_string = url_string.sub(/[)\]},;!?]+\z/, '')

    parsed = canonical_form(url_string)
    if parsed.nil?
      @stats[:urls_invalid] += 1
      return
    end

    # Skip internal IPs if exclude_internal flag is set
    if @exclude_internal && internal_ip?(parsed[:host])
      @stats[:excluded_internal] += 1
      return
    end

    @stats[:urls_valid] += 1
    key = parsed[:key]

    # Track variations and update canonical if needed (prefer https)
    if @dedup_map[key]
      entry = @dedup_map[key]
      entry[:variations] << url_string unless entry[:variations].include?(url_string)
      entry[:count] += 1

      # Update canonical if this is https and current is not
      if parsed[:scheme] == 'https' && entry[:canonical] !~ /^https:/
        entry[:canonical] = parsed[:url]
      end
    else
      @dedup_map[key] = {
        canonical: parsed[:url],
        variations: [url_string],
        count: 1,
        schemes: [parsed[:scheme]]
      }
    end
  end

  def default_port?(scheme, port)
    case scheme
    when 'http'  then port == 80
    when 'https' then port == 443
    when 'ftp'   then port == 21
    else false
    end
  end

  def warn_on_internal_ip(host)
    if host =~ /\A(localhost|127\.|192\.168\.|10\.|172\.1[6-9]\.|172\.2[0-9]\.|172\.3[01]\.)/
      msg = "Internal IP detected: #{host}"
      @warnings << msg
      @stats[:internal_ips] += 1
    end
  end

  def warn_on_user_info(uri)
    msg = "URL contains user info (stripped): #{uri.user}@***"
    @warnings << msg
    @stats[:user_info_urls] += 1
  end

  def internal_ip?(host)
    return false unless host

    host =~ /\A(localhost|127\.|192\.168\.|10\.|172\.1[6-9]\.|172\.2[0-9]\.|172\.3[01]\.)/
  end

  def normalize_path(path)
    # Normalize path: resolve . and .. segments
    # /path/to/./file becomes /path/to/file
    # /path/to/file/.. becomes /path/to
    segments = path.split('/').reject { |seg| seg.empty? || seg == '.' }
    normalized = []

    segments.each do |segment|
      if segment == '..'
        normalized.pop if normalized.any?
      else
        normalized << segment
      end
    end

    '/' + normalized.join('/')
  end
end

class CLI
  def initialize
    @options = {
      format: 'text',
      verbose: false,
      show_variations: false,
      output_file: nil,
      filter: nil,
      exclude_internal: false,
      base_url: nil
    }
  end

  def parse_options
    OptionParser.new do |opts|
      opts.banner = 'Usage: 2links [options] [FILE]'
      opts.separator ''
      opts.separator 'Extract, canonicalize, and deduplicate URLs from text'
      opts.separator ''

      opts.on('-f', '--format FORMAT', 'Output format: text|json (default: text)') do |fmt|
        @options[:format] = fmt
      end

      opts.on('-F', '--filter DOMAIN', 'Filter URLs by domain (partial match)') do |domain|
        @options[:filter] = domain
      end

      opts.on('-b', '--base-url URL', 'Base URL for resolving relative URLs (auto-adds https:// if no scheme)') do |url|
        @options[:base_url] = url
      end

      opts.on('-o', '--output FILE', 'Write output to file instead of stdout') do |file|
        @options[:output_file] = file
      end

      opts.on('-v', '--verbose', 'Show extraction statistics') do
        @options[:verbose] = true
      end

      opts.on('-V', '--variations', 'Include URL variations in JSON output') do
        @options[:show_variations] = true
      end

      opts.on('--no-internal', 'Exclude localhost and private IP addresses') do
        @options[:exclude_internal] = true
      end

      opts.on('-h', '--help', 'Show this help message') do
        puts opts
        exit 0
      end

      opts.on('--version', 'Show version') do
        puts '2links 1.0.0'
        exit 0
      end
    end.parse!
  end

  def run
    parse_options

    # Read input from file, stdin, or clipboard
    input = if ARGV.any?
              File.read(ARGV[0])
            elsif $stdin.tty?
              # Interactive terminal: read from clipboard
              read_from_clipboard
            else
              # stdin is piped: read from stdin
              $stdin.read
            end

    if input.nil? || input.empty?
      warn "[2links] Error: No input provided and clipboard is empty"
      exit 1
    end

    extractor = URLExtractor.new(
      input,
      exclude_internal: @options[:exclude_internal],
      base_url: @options[:base_url]
    )
    extractor.extract.deduplicate

    output(extractor)
  end

  def read_from_clipboard
    uname = `uname 2>/dev/null`.strip
    case uname
    when 'Darwin'
      `pbpaste 2>/dev/null`.chomp
    else
      # Try wayland clipboard (Linux)
      `wl-paste --no-newline 2>/dev/null`.chomp rescue nil
    end
  rescue StandardError
    nil
  end

  private

  def output(extractor)
    output_content = case @options[:format]
                     when 'json'
                       generate_json(extractor)
                     else
                       generate_text(extractor)
                     end

    # Write to file or stdout
    if @options[:output_file]
      File.write(@options[:output_file], output_content)
      warn "[2links] Output written to #{@options[:output_file]}" if @options[:verbose]
    else
      print output_content
    end

    print_stats(extractor) if @options[:verbose]
  end

  def generate_text(extractor)
    urls = extractor.sorted_urls(filter: @options[:filter])
    urls.map { |url| "#{url}\n" }.join
  end

  def generate_json(extractor)
    data = extractor.deduplicated_data(filter: @options[:filter]).map do |key, entry|
      obj = {
        canonical_url: entry[:canonical],
        domain: URI.parse(entry[:canonical]).host,
        count: entry[:count]
      }
      obj[:variations] = entry[:variations] if @options[:show_variations]
      obj
    end
    JSON.pretty_generate(data)
  end

  def print_stats(extractor)
    stats = extractor.stats
    warn "\n[2links] Statistics:"
    warn "  URLs found (absolute): #{stats[:urls_found]}"
    warn "  URLs found (relative): #{stats[:relative_urls]}" if stats[:relative_urls] > 0
    warn "  URLs valid: #{stats[:urls_valid]}"
    warn "  URLs invalid: #{stats[:urls_invalid]}" if stats[:urls_invalid] > 0
    warn "  Excluded (internal): #{stats[:excluded_internal]}" if stats[:excluded_internal] > 0
    warn "  Unique canonical URLs: #{extractor.sorted_urls.length}"
    warn "  Total variations: #{extractor.total_variations}"

    if stats[:internal_ips] > 0
      warn "  Internal IPs detected: #{stats[:internal_ips]}"
    end
    if stats[:user_info_urls] > 0
      warn "  URLs with user info: #{stats[:user_info_urls]}"
    end

    # Print warnings if any
    if extractor.warnings.any?
      warn "\n[2links] Warnings:"
      extractor.warnings.each { |warning| warn "  - #{warning}" }
    end
  end
end

# Main execution
if __FILE__ == $0
  CLI.new.run
end
