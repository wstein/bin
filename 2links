#!/usr/bin/env ruby
# frozen_string_literal: true

require 'uri'
require 'set'
require 'optparse'
require 'json'

class URLExtractor
  # Regex pattern to match URLs in text
  # Matches http(s), ftp, and other common schemes
  # Stops at quotes, angle brackets, and whitespace
  URL_PATTERN = %r{
    (?:https?|ftp)://
    [^\s"'<>]+
  }x

  # Track warnings and stats
  attr_reader :warnings, :stats

  def initialize(text)
    @text = text
    @urls = []
    @dedup_map = {} # maps dedup key (scheme-agnostic) to {canonical:, variations:, schemes:, count:}
    @warnings = []
    @stats = {
      urls_found: 0,
      urls_valid: 0,
      urls_invalid: 0,
      internal_ips: 0,
      user_info_urls: 0
    }
  end

  def extract
    # Find all URL matches in text
    @text.scan(URL_PATTERN) do |url_string|
      process_url(url_string)
    end
    self
  end

  def deduplicate
    # Deduplication already happens in process_url via @canonical_map
    self
  end

  def sorted_urls
    # Return sorted canonical URLs
    @dedup_map.values.map { |entry| entry[:canonical] }.sort
  end

  def deduplicated_data
    # Return deduplicated data organized by key, sorted by canonical URL
    @dedup_map.sort_by { |_, entry| entry[:canonical] }.to_h
  end

  def total_variations
    # Total count of URL variations across all deduplicated entries
    @dedup_map.values.sum { |entry| entry[:variations].length }
  end

  def dedup_key(uri, host, port, path)
    # Dedup key is scheme-agnostic: used to identify duplicate URLs with different schemes
    # format: host:port/path (no scheme)
    key = host&.downcase || ''
    key += ":#{port}" if port && !default_port?(uri.scheme, port)
    key += path
    key
  end

  def canonical_form(url_string)
    begin
      uri = URI.parse(url_string)

      # Validate scheme
      return nil unless %w[http https ftp].include?(uri.scheme)

      # Warn on internal IPs
      warn_on_internal_ip(uri.host) if uri.host

      # Warn on user info
      warn_on_user_info(uri) if uri.user

      # Build canonical form
      scheme = uri.scheme&.downcase
      host = uri.host&.downcase
      port = uri.port
      path = uri.path || ''

      # Normalize path: ensure leading / for non-empty paths, strip trailing /
      path = "/#{path}" unless path.empty? || path.start_with?('/')
      path = path.sub(%r{/$}, '') if path != '/' # strip trailing slash except for root

      # Create dedup key (scheme-agnostic)
      key = dedup_key(uri, host, port, path)

      # Build the canonical URL
      canonical_url = "#{scheme}://#{host}"
      canonical_url += ":#{port}" if port && !default_port?(scheme, port)
      canonical_url += path

      # Return both canonical URL and dedup key
      {
        scheme: scheme,
        host: host,
        port: port,
        path: path,
        key: key,
        url: canonical_url
      }
    rescue URI::InvalidURIError, StandardError => e
      msg = "Invalid URL '#{url_string}': #{e.message}"
      @warnings << msg
      nil
    end
  end

  private

  def process_url(url_string)
    @stats[:urls_found] += 1

    parsed = canonical_form(url_string)
    if parsed.nil?
      @stats[:urls_invalid] += 1
      return
    end

    @stats[:urls_valid] += 1
    key = parsed[:key]

    # Track variations and update canonical if needed (prefer https)
    if @dedup_map[key]
      entry = @dedup_map[key]
      entry[:variations] << url_string unless entry[:variations].include?(url_string)
      entry[:count] += 1

      # Update canonical if this is https and current is not
      if parsed[:scheme] == 'https' && entry[:canonical] !~ /^https:/
        entry[:canonical] = parsed[:url]
      end
    else
      @dedup_map[key] = {
        canonical: parsed[:url],
        variations: [url_string],
        count: 1,
        schemes: [parsed[:scheme]]
      }
    end
  end

  def default_port?(scheme, port)
    case scheme
    when 'http'  then port == 80
    when 'https' then port == 443
    when 'ftp'   then port == 21
    else false
    end
  end

  def warn_on_internal_ip(host)
    if host =~ /\A(localhost|127\.|192\.168\.|10\.|172\.1[6-9]\.|172\.2[0-9]\.|172\.3[01]\.)/
      msg = "Internal IP detected: #{host}"
      @warnings << msg
      @stats[:internal_ips] += 1
    end
  end

  def warn_on_user_info(uri)
    msg = "URL contains user info (stripped): #{uri.user}@***"
    @warnings << msg
    @stats[:user_info_urls] += 1
  end
end

class CLI
  def initialize
    @options = {
      format: 'text',
      verbose: false,
      show_variations: false
    }
  end

  def parse_options
    OptionParser.new do |opts|
      opts.banner = 'Usage: 2links [options] [FILE]'
      opts.separator ''
      opts.separator 'Extract, canonicalize, and deduplicate URLs from text'
      opts.separator ''

      opts.on('-f', '--format FORMAT', 'Output format: text|json (default: text)') do |fmt|
        @options[:format] = fmt
      end

      opts.on('-v', '--verbose', 'Show extraction statistics') do
        @options[:verbose] = true
      end

      opts.on('-V', '--variations', 'Include URL variations in JSON output') do
        @options[:show_variations] = true
      end

      opts.on('-h', '--help', 'Show this help message') do
        puts opts
        exit 0
      end

      opts.on('--version', 'Show version') do
        puts '2links 1.0.0'
        exit 0
      end
    end.parse!
  end

  def run
    parse_options

    # Read input from file or stdin
    input = if ARGV.any?
              File.read(ARGV[0])
            else
              $stdin.read
            end

    extractor = URLExtractor.new(input)
    extractor.extract.deduplicate

    output(extractor)
  end

  private

  def output(extractor)
    case @options[:format]
    when 'json'
      output_json(extractor)
    else
      output_text(extractor)
    end

    print_stats(extractor) if @options[:verbose]
  end

  def output_text(extractor)
    extractor.sorted_urls.each { |url| puts url }
  end

  def output_json(extractor)
    data = extractor.deduplicated_data.map do |key, entry|
      obj = {
        canonical_url: entry[:canonical],
        domain: URI.parse(entry[:canonical]).host,
        count: entry[:count]
      }
      obj[:variations] = entry[:variations] if @options[:show_variations]
      obj
    end
    puts JSON.pretty_generate(data)
  end

  def print_stats(extractor)
    stats = extractor.stats
    warn "\n[2links] Statistics:"
    warn "  URLs found: #{stats[:urls_found]}"
    warn "  URLs valid: #{stats[:urls_valid]}"
    warn "  URLs invalid: #{stats[:urls_invalid]}" if stats[:urls_invalid] > 0
    warn "  Unique canonical URLs: #{extractor.sorted_urls.length}"
    warn "  Total variations: #{extractor.total_variations}"

    if stats[:internal_ips] > 0
      warn "  Internal IPs detected: #{stats[:internal_ips]}"
    end
    if stats[:user_info_urls] > 0
      warn "  URLs with user info: #{stats[:user_info_urls]}"
    end

    # Print warnings if any
    if extractor.warnings.any?
      warn "\n[2links] Warnings:"
      extractor.warnings.each { |warning| warn "  - #{warning}" }
    end
  end
end

# Main execution
if __FILE__ == $0
  CLI.new.run
end
