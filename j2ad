#!/usr/bin/env elixir

defmodule J2AD do
  @moduledoc false

  @usage """
  Usage:
    j2ad [options] [INPUT.json [OUTPUT.aion]]
    cat INPUT.json | j2ad [options]

  Converts JSON to AION delimited syntax.

  Options:
    --pretty                  Pretty (expanded) output
    --no-pretty               Compact output (overrides config file)
    --width N                 Target line width (default: 100, min: 40)
    --object-threshold N      Expand objects with >= N fields even when compact
                              form fits; 0 disables this heuristic (default: 3)
    --expand-lists            Expand lists that contain non-scalar elements
    --no-expand-lists         Disable list expansion heuristic

  Config file (~/.j2adrc or .j2adrc in the current directory):
    pretty            true|false
    width             N
    object_threshold  N
    expand_lists      true|false

  Options may also use --width=N and --object-threshold=N forms. Config files
  support whole-line and inline # comments.

  CLI flags override .j2adrc which overrides ~/.j2adrc which overrides defaults.

  Default compact output:
    {"name":"Tom","age":100,"tags":["user","admin","a b c"]}
    -> {name Tom age 100 tags [user admin "a b c"]}

  Pretty output uses fuzzy layout:
    - Scalars and small structures stay inline when they fit within width.
    - Objects with >= object_threshold fields are always expanded.
    - Lists containing non-scalar elements are always expanded.
    - Opening { and [ appear on the same line as the key name.

  Example:
    {
      name Tom
      age 100
      tags [user admin "a b c"]
      address {
        street "1 Main St"
        city Springfield
      }
      meta {active true}
    }
  """

  @reserved_atoms MapSet.new([
                    "true",
                    "false",
                    "null"
                  ])

  @unsafe_atom_chars ~r/[\s{}\[\]"]/
  @indent_unit 2
  @default_width 100
  @default_object_threshold 3

  def main(argv) do
    {opts, args} = parse_args(argv)

    case args do
      ["-h"] ->
        IO.write(@usage)

      ["--help"] ->
        IO.write(@usage)

      [] ->
        read_stdin()
        |> convert_and_write(:stdio, opts)

      [input] ->
        input
        |> File.read!()
        |> convert_and_write(:stdio, opts)

      [input, output] ->
        rendered =
          input
          |> File.read!()
          |> convert!(opts)

        File.write!(output, rendered <> "\n")

      _ ->
        IO.puts(:stderr, @usage)
        System.halt(64)
    end
  rescue
    error in File.Error ->
      IO.puts(:stderr, "file error: #{Exception.message(error)}")
      System.halt(66)

    error in JSON.DecodeError ->
      IO.puts(:stderr, "invalid JSON: #{Exception.message(error)}")
      System.halt(65)

    error ->
      IO.puts(:stderr, "error: #{Exception.message(error)}")
      System.halt(1)
  end

  defp default_opts do
    %{
      pretty?: false,
      width: @default_width,
      object_threshold: @default_object_threshold,
      expand_lists: true
    }
  end

  defp parse_args(argv) do
    {cli_opts, args, invalid} =
      OptionParser.parse(argv,
        strict: [
          pretty: :boolean,
          width: :integer,
          object_threshold: :integer,
          expand_lists: :boolean,
          help: :boolean
        ],
        aliases: [h: :help]
      )

    if invalid != [] do
      invalid_option_error(invalid)
    end

    opts =
      default_opts()
      |> merge_config(load_config(Path.expand("~/.j2adrc")))
      |> merge_config(load_config(".j2adrc"))
      |> merge_cli_flags(cli_opts)

    if Keyword.get(cli_opts, :help, false) do
      {opts, ["--help" | args]}
    else
      {opts, args}
    end
  end

  defp merge_config(opts, extra), do: Map.merge(opts, extra)

  defp invalid_option_error(invalid) do
    cond do
      Enum.any?(invalid, &(elem(&1, 0) == "--width")) ->
        flag_error("--width must be an integer >= 40")

      Enum.any?(invalid, &(elem(&1, 0) == "--object-threshold")) ->
        flag_error("--object-threshold must be an integer >= 0")

      true ->
        invalid
        |> Enum.map(&elem(&1, 0))
        |> Enum.join(", ")
        |> then(&flag_error("unknown option(s): #{&1}"))
    end
  end

  defp merge_cli_flags(opts, cli_opts) do
    %{
      opts
      | pretty?: cli_bool(cli_opts, :pretty, opts.pretty?),
        width: cli_int(cli_opts, :width, "--width", opts.width, min: 40),
        object_threshold:
          cli_int(
            cli_opts,
            :object_threshold,
            "--object-threshold",
            opts.object_threshold,
            min: 0
          ),
        expand_lists: cli_bool(cli_opts, :expand_lists, opts.expand_lists)
    }
  end

  defp cli_bool(cli_opts, key, default) do
    values = Keyword.get_values(cli_opts, key)

    cond do
      false in values -> false
      true in values -> true
      true -> default
    end
  end

  defp cli_int(cli_opts, key, name, default, min: min) do
    case Keyword.get_values(cli_opts, key) do
      [] ->
        default

      [value] when is_integer(value) and value >= min ->
        value

      [_value] ->
        flag_error("#{name} must be an integer >= #{min}")

      _ ->
        flag_error("#{name} may be provided only once")
    end
  end

  defp flag_error(msg) do
    IO.puts(:stderr, "error: #{msg}")
    System.halt(64)
  end

  # ---------------------------------------------------------------------------
  # Config file
  # ---------------------------------------------------------------------------

  defp load_config(path) do
    case File.read(path) do
      {:ok, content} ->
        parse_config(content, path)

      {:error, :enoent} ->
        %{}

      {:error, reason} ->
        IO.puts(:stderr, "warning: cannot read #{path}: #{:file.format_error(reason)}")
        %{}
    end
  end

  defp parse_config(content, path) do
    content
    |> String.split("\n")
    |> Enum.with_index(1)
    |> Enum.map(fn {line, lineno} -> {strip_inline_comment(line), lineno} end)
    |> Enum.reject(fn {line, _} ->
      t = String.trim(line)
      t == "" or String.starts_with?(t, "#")
    end)
    |> Enum.reduce(%{}, fn {line, lineno}, acc ->
      case String.split(String.trim(line), ~r/\s+/, parts: 2) do
        [key, value] ->
          parse_config_entry(acc, key, String.trim(value), path, lineno)

        _ ->
          IO.puts(:stderr, "warning: #{path}:#{lineno}: malformed line, ignoring")
          acc
      end
    end)
  end

  defp strip_inline_comment(line) do
    line
    |> String.split("#", parts: 2)
    |> hd()
    |> String.trim()
  end

  defp parse_config_entry(acc, key, value, path, lineno) do
    warn = fn msg -> IO.puts(:stderr, "warning: #{path}:#{lineno}: #{msg}, ignoring") end

    case key do
      "width" ->
        case Integer.parse(value) do
          {n, ""} when n >= 40 ->
            Map.put(acc, :width, n)

          _ ->
            warn.("width must be an integer >= 40")
            acc
        end

      "object_threshold" ->
        case Integer.parse(value) do
          {n, ""} when n >= 0 ->
            Map.put(acc, :object_threshold, n)

          _ ->
            warn.("object_threshold must be a non-negative integer")
            acc
        end

      "expand_lists" ->
        case parse_bool(value) do
          {:ok, b} ->
            Map.put(acc, :expand_lists, b)

          :error ->
            warn.("expand_lists must be true/false/on/off/yes/no")
            acc
        end

      "pretty" ->
        case parse_bool(value) do
          {:ok, b} ->
            Map.put(acc, :pretty?, b)

          :error ->
            warn.("pretty must be true/false/on/off/yes/no")
            acc
        end

      _ ->
        warn.("unknown key #{inspect(key)}")
        acc
    end
  end

  defp parse_bool(v) do
    case String.downcase(v) do
      s when s in ["true", "on", "yes", "1"] -> {:ok, true}
      s when s in ["false", "off", "no", "0"] -> {:ok, false}
      _ -> :error
    end
  end

  # ---------------------------------------------------------------------------
  # Public API (also used by tests)
  # ---------------------------------------------------------------------------

  @doc false
  def convert!(json_text, opts) do
    value = decode!(json_text)

    if opts.pretty? do
      render_pretty(value, 0, opts)
    else
      render_compact(value)
    end
  end

  @doc false
  def parse_config_text(text), do: parse_config(text, "<text>")

  # ---------------------------------------------------------------------------
  # I/O helpers
  # ---------------------------------------------------------------------------

  defp read_stdin do
    IO.read(:stdio, :eof)
  end

  defp convert_and_write(json_text, :stdio, opts) do
    IO.puts(convert!(json_text, opts))
  end

  defp decode!(json_text) do
    decoders = [
      object_finish: fn acc, old_acc -> {{:object, Enum.reverse(acc)}, old_acc} end
    ]

    case JSON.decode(json_text, :ok, decoders) do
      {decoded, :ok, ""} ->
        decoded

      {:error, {:unexpected_end, offset}} ->
        raise JSON.DecodeError,
          message: "unexpected end of JSON binary at position (byte offset) #{offset}",
          data: json_text,
          offset: offset

      {:error, {:invalid_byte, offset, byte}} ->
        raise JSON.DecodeError,
          message: "invalid byte #{byte} at position (byte offset) #{offset}",
          data: json_text,
          offset: offset

      {:error, {:unexpected_sequence, offset, bytes}} ->
        raise JSON.DecodeError,
          message: "unexpected sequence #{inspect(bytes)} at position (byte offset) #{offset}",
          data: json_text,
          offset: offset

      {_, :ok, rest} ->
        raise JSON.DecodeError,
          message: "unexpected trailing content",
          data: json_text,
          offset: byte_size(json_text) - byte_size(rest)
    end
  end

  # ---------------------------------------------------------------------------
  # Compact rendering
  # ---------------------------------------------------------------------------

  defp render_compact({:object, entries}) do
    inner =
      entries
      |> Enum.map(fn {key, value} ->
        render_key(key) <> " " <> render_compact(value)
      end)
      |> Enum.join(" ")

    "{" <> inner <> "}"
  end

  defp render_compact(value) when is_list(value) do
    inner =
      value
      |> Enum.map(&render_compact/1)
      |> Enum.join(" ")

    "[" <> inner <> "]"
  end

  defp render_compact(value), do: render_scalar(value)

  # ---------------------------------------------------------------------------
  # Pretty rendering
  # ---------------------------------------------------------------------------

  defp render_pretty({:object, entries} = obj, level, opts) do
    compact = render_compact(obj)

    if level > 0 and fits?(compact, level, opts) and not should_expand?(obj, opts) do
      compact
    else
      render_record_block(entries, level, opts)
    end
  end

  defp render_pretty(value, level, opts) when is_list(value) do
    compact = render_compact(value)

    if fits?(compact, level, opts) and not should_expand?(value, opts) do
      compact
    else
      render_list_block(value, level, opts)
    end
  end

  defp render_pretty(value, _level, _opts), do: render_scalar(value)

  defp render_record_block(entries, level, opts) do
    if entries == [] do
      "{}"
    else
      body =
        entries
        |> Enum.map(fn {key, child} ->
          render_record_line(key, child, level + 1, opts)
        end)
        |> Enum.join("\n")

      close = indent(level) <> "}"

      Enum.join(["{", body, close], "\n")
    end
  end

  defp render_record_line(key, child, level, opts) do
    key_text = render_key(key)
    line_prefix = indent(level) <> key_text <> " "

    compact_child = render_compact(child)

    cond do
      scalar?(child) ->
        line_prefix <> render_scalar(child)

      fits?(compact_child, level, opts, String.length(key_text) + 1) and
          not should_expand?(child, opts) ->
        line_prefix <> compact_child

      match?({:object, _}, child) ->
        {:object, entries} = child
        line_prefix <> render_object_block_inline(entries, level, opts)

      is_list(child) ->
        line_prefix <> render_list_block_inline(child, level, opts)
    end
  end

  defp render_list_block(list, level, opts) do
    if list == [] do
      "[]"
    else
      body =
        list
        |> Enum.map(fn child ->
          indent(level + 1) <> render_pretty(child, level + 1, opts)
        end)
        |> Enum.join("\n")

      close = indent(level) <> "]"

      Enum.join(["[", body, close], "\n")
    end
  end

  defp render_object_block_inline(entries, level, opts) do
    if entries == [] do
      "{}"
    else
      body =
        entries
        |> Enum.map(fn {key, child} ->
          render_record_line(key, child, level + 1, opts)
        end)
        |> Enum.join("\n")

      "{\n" <> body <> "\n" <> indent(level) <> "}"
    end
  end

  defp render_list_block_inline(list, level, opts) do
    if list == [] do
      "[]"
    else
      body =
        list
        |> Enum.map(fn child ->
          indent(level + 1) <> render_pretty(child, level + 1, opts)
        end)
        |> Enum.join("\n")

      "[\n" <> body <> "\n" <> indent(level) <> "]"
    end
  end

  # Fuzzy heuristics: expand even when compact form fits within width.
  # Thresholds are configurable via CLI flags and config file.
  defp should_expand?({:object, entries}, opts),
    do: opts.object_threshold > 0 and length(entries) >= opts.object_threshold

  defp should_expand?(list, opts) when is_list(list),
    do: opts.expand_lists and Enum.any?(list, &(not scalar?(&1)))

  defp should_expand?(_, _opts), do: false

  defp fits?(text, level, opts, extra_prefix_len \\ 0) do
    String.length(text) + level * @indent_unit + extra_prefix_len <= opts.width
  end

  # ---------------------------------------------------------------------------
  # Scalars and atoms
  # ---------------------------------------------------------------------------

  defp render_key(key) when is_binary(key) do
    render_atom_or_string(key)
  end

  defp render_scalar(value) when is_binary(value), do: render_atom_or_string(value)
  defp render_scalar(value) when is_integer(value), do: Integer.to_string(value)
  defp render_scalar(value) when is_float(value), do: render_float(value)
  defp render_scalar(true), do: "true"
  defp render_scalar(false), do: "false"
  defp render_scalar(nil), do: "null"

  defp render_atom_or_string(value) do
    if safe_atom?(value) do
      value
    else
      render_string(value)
    end
  end

  defp safe_atom?(""), do: false

  defp safe_atom?(value) do
    not MapSet.member?(@reserved_atoms, value) and
      not String.match?(value, @unsafe_atom_chars) and
      not Enum.any?(String.to_charlist(value), &(&1 < 0x20))
  end

  defp render_string(value) do
    escaped = value |> String.to_charlist() |> Enum.map_join(&escape_string_char/1)

    "\"" <> escaped <> "\""
  end

  defp escape_string_char(?\\), do: "\\\\"
  defp escape_string_char(?"), do: "\\\""
  defp escape_string_char(?\b), do: "\\b"
  defp escape_string_char(?\f), do: "\\f"
  defp escape_string_char(?\n), do: "\\n"
  defp escape_string_char(?\r), do: "\\r"
  defp escape_string_char(?\t), do: "\\t"

  defp escape_string_char(char) when char < 0x20 do
    char
    |> Integer.to_string(16)
    |> String.pad_leading(4, "0")
    |> then(&"\\u#{&1}")
  end

  defp escape_string_char(char), do: <<char::utf8>>

  defp render_float(value) do
    :erlang.float_to_binary(value, [:short])
  end

  defp scalar?(value) do
    is_binary(value) or is_integer(value) or is_float(value) or is_boolean(value) or is_nil(value)
  end

  defp indent(level) do
    String.duplicate(" ", level * @indent_unit)
  end
end

unless System.get_env("J2AD_TESTING") do
  J2AD.main(System.argv())
end
